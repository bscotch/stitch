{
  "name": "@bscotch/sprite-source",
  "version": "1.6.0",
  "description": "Art pipeline scripting module for GameMaker sprites.",
  "keywords": [
    "sprite",
    "image",
    "2D",
    "gamemaker",
    "game maker",
    "art",
    "art asset",
    "pipeline",
    "spine"
  ],
  "homepage": "https://github.com/bscotch/stitch/tree/develop/packages/sprite-source#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bscotch/stitch.git",
    "directory": "packages/sprite-source"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "spsrc": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsc --build && node scripts/build-schemas.mjs",
    "test": "node --test --test-timeout=10000 \"src/**/*.test.ts\"",
    "watch": "tsc --build --watch"
  },
  "dependencies": {
    "@bscotch/pathy": "^2.12.1",
    "@bscotch/pixel-checksum": "^1.0.0",
    "@bscotch/utility": "^7.2.0",
    "@bscotch/yy": "workspace:*",
    "citty": "0.1.6",
    "image-js": "0.37.0",
    "tslib": "^2.8.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
