{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number"
    },
    "info": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "spine": {
                "type": "boolean",
                "const": false
              },
              "checksum": {
                "description": "A checksum combining the pixel-based checksums of all of the frame checksums.",
                "type": "string"
              },
              "frames": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "width": {
                      "type": "number"
                    },
                    "height": {
                      "type": "number"
                    },
                    "checksum": {
                      "description": "Pixel-based checksum of the image.",
                      "type": "string"
                    },
                    "changed": {
                      "description": "Unix timestamp of last modification date.",
                      "type": "number"
                    }
                  },
                  "required": [
                    "width",
                    "height",
                    "checksum",
                    "changed"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "spine",
              "checksum",
              "frames"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "spine": {
                "type": "boolean",
                "const": true
              },
              "checksum": {
                "description": "A checksum combining the pixel-based checksum of the atlas file with the contets of the atlas and json files.",
                "type": "string"
              },
              "changed": {
                "description": "Unix timestamp of the most recent modified date for all associate files (atlas, json, png).",
                "type": "number"
              }
            },
            "required": [
              "spine",
              "checksum",
              "changed"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "info"
  ],
  "additionalProperties": false
}