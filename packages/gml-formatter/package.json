{
  "name": "@bscotch/gml-formatter",
  "version": "1.0.0",
  "description": "A safe, configurable code formatter for GML (GameMaker Language) that preserves your line breaks.",
  "keywords": [
    "gml",
    "formatter",
    "gamemaker",
    "game maker language",
    "stitch"
  ],
  "homepage": "https://github.com/bscotch/stitch/tree/develop/packages/gml-formatter#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bscotch/stitch.git",
    "directory": "packages/gml-formatter"
  },
  "license": "MIT",
  "author": "Adam Coster (https://www.bscotch.net/about#adam-coster)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "clean": "node ../../scripts/clean.mjs build dist \"*.tsbuildinfo\" \"**/*.tsbuildinfo\"",
    "test": "node --test --test-timeout=120000 \"src/**/*.test.ts\"",
    "watch": "tsc --build --watch"
  },
  "dependencies": {
    "@bscotch/gml-syntax": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
