{
  "name": "@bscotch/yy",
  "version": "3.0.0",
  "description": "Stringify, parse, read, and write GameMaker yy and yyp files.",
  "keywords": [
    "yy",
    "yyp",
    "game maker",
    "gamemaker",
    "yoyo",
    "json",
    "parse",
    "stringify",
    "file",
    "read",
    "write"
  ],
  "homepage": "https://github.com/bscotch/stitch/tree/develop/packages/yy#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bscotch/stitch.git",
    "directory": "packages/yy"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./version": {
      "types": "./dist/types/GameMakerVersionString.d.ts",
      "import": "./dist/types/GameMakerVersionString.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "yy": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "node ../../scripts/clean.mjs build dist \"*.tsbuildinfo\" \"**/*.tsbuildinfo\"",
    "test": "node --test --test-timeout=10000 \"src/**/*.test.ts\"",
    "watch": "tsc --build --watch"
  },
  "dependencies": {
    "@bscotch/utility": "^7.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
