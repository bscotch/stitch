{
  "name": "@bscotch/gamemaker-releases",
  "version": "0.8.0",
  "description": "A unified feed of GameMaker IDE releases and their paired Runtimes, across all channels and platforms.",
  "keywords": [
    "gamemaker",
    "game-maker",
    "release",
    "releases",
    "runtime",
    "ide",
    "lts",
    "beta",
    "yoyo",
    "bscotch",
    "stitch",
    "rss",
    "feed"
  ],
  "homepage": "https://github.com/bscotch/stitch/tree/develop/packages/releases#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bscotch/gamemaker-info.git",
    "directory": "packages/releases"
  },
  "license": "MIT",
  "author": "Butterscotch Shenanigans",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "clean": "node ../../scripts/clean.mjs build dist",
    "test": "node --test --test-timeout=30000 \"src/**/*.test.ts\"",
    "watch": "tsc --build --watch"
  },
  "dependencies": {
    "@bscotch/yy": "workspace:*",
    "entities": "^9.0.0",
    "fast-xml-parser": "^5.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
