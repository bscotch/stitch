{
  "name": "@bscotch/steam-bbcode",
  "version": "0.4.0",
  "description": "Generate Steam-compatible BBCode from Markdown.",
  "homepage": "https://github.com/bscotch/stitch/tree/develop/packages/steam-bbcode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bscotch/stitch.git",
    "directory": "packages/steam-bbcode"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "test": "node --test --test-concurrency=1 --test-timeout=30000 \"src/**/*.test.ts\"",
    "watch": "tsc --build --watch"
  },
  "dependencies": {
    "marked": "18.2.1"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
