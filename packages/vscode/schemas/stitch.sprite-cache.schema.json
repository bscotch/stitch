{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "default": "https://raw.githubusercontent.com/bscotch/stitch/refs/heads/develop/packages/sprite-source/schemas/stitch.sprite-cache.schema.json",
      "type": "string"
    },
    "version": {
      "default": 1,
      "type": "number"
    },
    "info": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "spine": {
                "type": "boolean",
                "const": false
              },
              "checksum": {
                "type": "string",
                "description": "A checksum combining the pixel-based checksums of all of the frame checksums."
              },
              "frames": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "width": {
                      "type": "number"
                    },
                    "height": {
                      "type": "number"
                    },
                    "checksum": {
                      "type": "string",
                      "description": "Pixel-based checksum of the image."
                    },
                    "changed": {
                      "type": "number",
                      "description": "Unix timestamp of last modification date."
                    }
                  },
                  "required": [
                    "width",
                    "height",
                    "checksum",
                    "changed"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "spine",
              "checksum",
              "frames"
            ],
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "spine": {
                "type": "boolean",
                "const": true
              },
              "checksum": {
                "type": "string",
                "description": "A checksum combining the pixel-based checksum of the atlas file with the contets of the atlas and json files."
              },
              "changed": {
                "type": "number",
                "description": "Unix timestamp of the most recent modified date for all associate files (atlas, json, png)."
              }
            },
            "required": [
              "spine",
              "checksum",
              "changed"
            ],
            "additionalProperties": {}
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "info"
  ],
  "additionalProperties": {}
}