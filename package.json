{
  "name": "@local/stitch-monorepo",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "bump": "node scripts/bump.mts",
    "changelogs": "node scripts/changelogs.mts",
    "build:all": "pnpm run -r --if-present build",
    "test:all": "pnpm run -r --if-present test",
    "clean:artifacts": "node ./scripts/nuke-builds.mjs",
    "clean:deps": "node ./scripts/nuke-deps.mjs",
    "fix:deps": "syncpack fix-mismatches",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "watch": "pnpm run -r --if-present --parallel --stream watch",
    "setup:pnpm": "corepack prepare $npm_package_packageManager --activate",
    "test:scripts": "node --test \"scripts/**/*.test.mts\"",
    "typecheck:scripts": "tsc -p scripts"
  },
  "dependencies": {
    "@bscotch/pathy": "^2.12.1",
    "@types/node": "^25.0.3",
    "del": "8.0.1",
    "prettier": "^3.7.4",
    "syncpack": "^13.0.4",
    "zx": "^8.8.5"
  },
  "syncpack": {
    "workspace": false,
    "source": [
      "package.json",
      "packages/*/package.json"
    ]
  },
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.13.1",
    "globals": "^17.14.0",
    "svelte": "^5.46.1",
    "typescript": "6.0.3",
    "typescript-eslint": "~8.73.0"
  }
}
