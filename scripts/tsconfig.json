{
  "extends": "../config/tsconfig.base.json",
  "include": ["**/*.mts", "**/*.js", "**/*.mjs", "**/*.cjs"],
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "lib": ["esnext"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  }
}
